{
  "opencollection": "1.0.0",
  "info": {
    "name": "Listrak Cross Channel REST app-push-mobile-client-device Folder API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Folder",
        "type": "folder"
